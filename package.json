{
  "name": "skinvaults-2",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:unit": "node --env-file=.env --import tsx --test tests/*.test.ts",
    "test": "npm run typecheck && npm run check:secrets && npm run test:unit",
    "db:dev": "docker start skinvaults2-dev-pg 2>/dev/null || sh scripts/dev-db.sh",
    "owner:hash": "node --import tsx scripts/owner-hash.ts",
    "smtp:verify": "node --env-file=.env --import tsx scripts/smtp-verify.ts"
  },
  "dependencies": {
    "nodemailer": "7.0.10",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.15.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
