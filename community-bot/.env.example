# Required
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=


# Optional
# Extra Discord user ids (comma separated) that may run /lockdown and /community. The server owner always may.
OWNER_IDS=
# Comma separated role ids of the team: they see every channel during lockdown and every feedback ticket
STAFF_ROLE_IDS=
# Set to 1 only after enabling "Message Content Intent" in the developer portal; needed to save ticket transcripts
ENABLE_MESSAGE_CONTENT=
# Where state, snapshots and the feedback log are kept (on Nebula: /data)
DATA_DIR=./data
# Role every human member gets on join and in a check every 5 minutes. Needs the Server Members intent in the developer portal.
MEMBER_ROLE_ID=
