# Copy to .env for local work. Never commit .env. On Nebula Host set these as the app's environment variables.
# The app refuses to start and lists every missing variable by name (never by value).

# PostgreSQL connection string, e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=
# Bearer token that protects /status. Use a long random string.
STATUS_TOKEN=

# SMTP (Hostinger in the old site: smtp.hostinger.com, port 587, STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender, e.g. "Skinvaults <no-reply@example.com>"
SMTP_FROM=

# Where failure alerts go. At least one should be set so a dead message reaches a human.
OWNER_ALERT_EMAIL=
# Discord webhooks are named, never stored in the database. DISCORD_WEBHOOK_<NAME> is used by outbox rows with webhook "<name>".
DISCORD_WEBHOOK_ALERTS=

# Public site (all optional; the defaults suit local work)
# Canonical address without a trailing slash. Used for canonical links, the sitemap and links in e-mails.
PUBLIC_BASE_URL=https://skinvaults.online
# Shown on the home page when set, e.g. https://discord.gg/abcdef
DISCORD_INVITE_URL=
# Shown on the privacy page as the address for data requests
CONTACT_EMAIL=

# Optional
PORT=3000
LOG_LEVEL=info
